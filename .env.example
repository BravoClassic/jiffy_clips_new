# To access your Clerk keys, first create a clerk.com account then open dashboard.clerk.com. Create a new Clerk application and copy the Keys from step 2 in the Next.js quickstart tab.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/home

# Used by /upload to auto-generate a description, tags, and categories for videos.
# Get a free API key at https://console.groq.com (API Keys section).
GROQ_API_KEY=

# App data is stored locally in a SQLite database (prisma/dev.db), no env var needed.
